# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit real keys.
# ---------------------------------------------------------------------------

# App display name (shown in the header and page title).
NEXT_PUBLIC_APP_NAME="Best Bites"

# --- Google Maps Platform -------------------------------------------------

# SERVER key: used only in route handlers, never sent to the browser.
# API restrictions: "Places API (New)" and "Places Aggregate API".
# Application restriction: server IP addresses where possible (Vercel egress IPs vary,
# so there rely on API restrictions + quotas).
GOOGLE_PLACES_API_KEY=

# BROWSER key: exposed to the client on purpose, for the map and address search.
# API restrictions: "Maps JavaScript API" and "Places API (New)" (used by PlaceAutocompleteElement).
# Application restriction: HTTP referrers, e.g. https://your-domain.com/* and http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_JS_API_KEY=

# Map ID (required for Advanced Markers). Cloud Console → Google Maps Platform → Map Management.
# "DEMO_MAP_ID" is for development only.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Cost control ----------------------------------------------------------

# Max Place Details calls per search (each is billed at the Place Details Enterprise SKU).
MAX_DETAILS_PER_SEARCH=60
# Parallel Place Details requests.
DETAILS_CONCURRENCY=8
# Max Places Aggregate calls per search (counts + place lists, including sub-area splits).
MAX_AGGREGATE_CALLS_PER_SEARCH=60
# Cache lifetime for place-ID lists per rounded location, in seconds. Google allows storing
# place IDs indefinitely; we refresh weekly because ratings change.
PLACE_ID_CACHE_TTL_SECONDS=604800
# Per-IP rate limits (requests per minute).
RATE_LIMIT_PER_MINUTE=10
PHOTO_RATE_LIMIT_PER_MINUTE=120

# --- Shared store (recommended in production) --------------------------------
# Upstash Redis REST credentials for the place-ID cache and rate limiting.
# If unset, an in-memory store is used (per server instance; not shared on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Instagram (optional) -----------------------------------------------------
# Set to "true" once the Meta app's permissions are approved.
INSTAGRAM_ENABLED=false
# ID of OUR Instagram Business account (linked to the Facebook Page used by the Meta app).
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Long-lived access token for that account (see README → Instagram setup).
INSTAGRAM_ACCESS_TOKEN=
# Graph API version; set to the current version from Meta's changelog.
META_GRAPH_API_VERSION=v23.0
